{
  "manifest_version": 3,
  "name": "Typing Bot Extension",
  "version": "1.0",
  "description": "Scrapes text from HTML elements and automatically types it with human-like behavior",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Typing Bot - Click to Auto Type",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
} 